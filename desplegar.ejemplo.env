# Copiar como .desplegar.env (no se sube a git) y completar.

# Usuario y dirección del VPS para ssh (usuario@IP o usuario@dominio)
VPS="ubuntu@IP-DEL-VPS"
PUERTO_SSH=22

# Carpeta del sitio en el VPS: la que tiene api/, img/ y subidas/
RUTA="/var/www/mmm-utha"

# Dirección pública del backend, para probarlo al terminar
URL="https://mmm.devpess.com"

# "si" para subir también la web (index.html, paginas/, css/, js/) al
# VPS. "no" si la web vive en otro hosting.
SUBIR_WEB="no"
