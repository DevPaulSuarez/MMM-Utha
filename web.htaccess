# MMM · Reglas de caché para la web publicada (InfinityFree)
# preparar-web.sh lo copia como .htaccess en la raíz del sitio.

<IfModule mod_headers.c>
  # Las páginas y la copia de datos se revisan en cada visita: así un
  # cambio publicado se ve enseguida, sin ventana de incógnito
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CSS y JS se piden con ?v=<huella> (preparar-web.sh): cuando cambian,
  # cambia la dirección, así que se pueden guardar mucho tiempo
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Las imágenes cambian poco: una semana
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
